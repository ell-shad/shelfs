{
  "name": "bookshelf",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first PDF and EPUB library drawn as a 3D wooden bookcase.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync:pdfjs": "node scripts/sync-pdfjs-assets.mjs",
    "predev:web": "npm run sync:pdfjs",
    "dev:web": "vite",
    "prebuild:web": "npm run sync:pdfjs",
    "build:web": "tsc --noEmit && vite build",
    "preview:web": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ui/src --max-warnings 0",
    "test": "vitest run",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --no-bundle",
    "bundle": "tauri build",
    "bundle:deb": "tauri build --bundles deb",
    "bundle:appimage": "tauri build --bundles appimage"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "pdfjs-dist": "6.4.299",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.0.18"
  }
}
